# TAPASYA Backend Environment Variables

PORT=5001
NODE_ENV=development

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-host.region.aws.neon.tech/neondb?sslmode=require

# JWT Secret
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173
